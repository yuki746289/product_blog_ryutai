      "latex": "\\[\n\\left\\{\n\\begin{aligned}\nx&=r\\sin\\theta\\cos\\phi\\\\[6pt]\ny&=r\\sin\\theta\\sin\\phi\\\\[6pt]\nz&=r\\cos\\theta\n\\end{aligned}\n\\right.\n\\]"
