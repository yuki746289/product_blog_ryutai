      "image": "image004.png",
      "latex": "\\[\\begin{aligned}\\frac{\\partial\\chi(a,b)}{\\partial a}&=2na+2b\\sum_{i=1}^{n}x_i-2\\sum_{i=1}^{n}y_i\\\\[6pt]&=0\\end{aligned}\\]"
    },
