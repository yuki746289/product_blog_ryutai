    {
      "image": "image005.png",
      "latex": "\\[\\begin{aligned}dr^2&=\\sum_{i=1}^{4}(r_i-r)^2\\\\[6pt]&=\\sum_{i=1}^{4}(r^2-2r_ir+r_i^2)\\\\[6pt]&=\\sum_{i=1}^{4}r^2-\\sum_{i=1}^{4}2r_ir+\\sum_{i=1}^{4}r_i^2\\\\[6pt]&=4r^2-2\\sum_{i=1}^{4}r_ir+\\sum_{i=1}^{4}r_i^2\\\\[6pt]&=4r^2-2ar+b\\\\[6pt]&=4\\left(r^2-\\frac{1}{2}ar+\\frac{b}{4}\\right)\\\\[6pt]&=4\\left\\{\\left(r^2-\\frac{1}{2}ar+\\frac{1}{16}a^2\\right)-\\frac{1}{16}a^2+\\frac{b}{4}\\right\\}\\\\[6pt]&=4\\left\\{\\left(r-\\frac{1}{4}a\\right)^2-\\frac{1}{16}a^2+\\frac{b}{4}\\right\\}\\\\[6pt]&=4\\left\\{\\left(r-\\frac{1}{4}a\\right)^2-\\frac{1}{16}a^2+\\frac{b}{4}\\right\\}\\\\[6pt]&=4\\left(r-\\frac{1}{4}a\\right)^2-\\frac{1}{4}a^2+b\\end{aligned}\\]"
    },
