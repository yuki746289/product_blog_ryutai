      "latex": "\\[\\begin{aligned}x_g&=\\frac{1}{4}\\sum_{i=1}^{4}x_i\\\\[6pt]y_g&=\\frac{1}{4}\\sum_{i=1}^{4}y_i\\\\[6pt]z_g&=\\frac{1}{4}\\sum_{i=1}^{4}z_i\\end{aligned}\\]"
    },
    {
      "image": "image004.png",
      "latex": "\\[r_i=\\sqrt{(x_i-x_g)^2+(y_i-y_g)^2+(z_i-z_g)^2}\\]"
